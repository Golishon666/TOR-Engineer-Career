  <string id="tor_career_description.Engineer" text="{=tor_engineer_desc}Engineers turn powder, steel and measurement into battlefield doctrine. They fight through firearms, ammunition discipline, armor penetration and experimental shot." />

  <string id="tor_careerchoice_description.EngineerRoot" text="{=tor_engineer_root}Firearm damage charges Open Fire!." />

  <string id="tor_careerchoice_description.PowderDrillKeystone" text="{=tor_engineer_powder_key}Open Fire!: +5s; scales Gunpowder." />
  <string id="tor_careerchoice_description.PowderDrillPassive1" text="{=tor_engineer_powder_p1}+6 ammo per pouch." />
  <string id="tor_careerchoice_description.PowderDrillPassive2" text="{=tor_engineer_powder_p2}+10% gunpowder damage." />
  <string id="tor_careerchoice_description.PowderDrillPassive3" text="{=tor_engineer_powder_p3}+15% firearm accuracy." />
  <string id="tor_careerchoice_description.PowderDrillPassive4" text="{=tor_engineer_powder_p4}Ranged troops: +25 Gunpowder." />

  <string id="tor_careerchoice_description.FieldTestingKeystone" text="{=tor_engineer_field_key}Open Fire!: resist; scales Athletics." />
  <string id="tor_careerchoice_description.FieldTestingPassive1" text="{=tor_engineer_field_p1}+6 ammo per pouch." />
  <string id="tor_careerchoice_description.FieldTestingPassive2" text="{=tor_engineer_field_p2}+15% ranged resist." />
  <string id="tor_careerchoice_description.FieldTestingPassive3" text="{=tor_engineer_field_p3}+15% firearm speed." />
  <string id="tor_careerchoice_description.FieldTestingPassive4" text="{=tor_engineer_field_p4}+1 map speed." />

  <string id="tor_careerchoice_description.ExplosiveRoundsKeystone" text="{=tor_engineer_explosive_key}Bullets explode; Open Fire! +radius." />
  <string id="tor_careerchoice_description.ExplosiveRoundsPassive1" text="{=tor_engineer_explosive_p1}+6 ammo per pouch." />
  <string id="tor_careerchoice_description.ExplosiveRoundsPassive2" text="{=tor_engineer_explosive_p2}No ranged stagger." />
  <string id="tor_careerchoice_description.ExplosiveRoundsPassive3" text="{=tor_engineer_explosive_p3}Ranged troops: +10% damage." />
  <string id="tor_careerchoice_description.ExplosiveRoundsPassive4" text="{=tor_engineer_explosive_p4}+10% ranged pierce." />

  <string id="tor_careerchoice_description.SuppressionFireKeystone" text="{=tor_engineer_suppression_key}Open Fire!: +area, +resist." />
  <string id="tor_careerchoice_description.SuppressionFirePassive1" text="{=tor_engineer_suppression_p1}+6 ammo per pouch." />
  <string id="tor_careerchoice_description.SuppressionFirePassive2" text="{=tor_engineer_suppression_p2}Ranged troops: +10% resist." />
  <string id="tor_careerchoice_description.SuppressionFirePassive3" text="{=tor_engineer_suppression_p3}+10% gunpowder damage." />
  <string id="tor_careerchoice_description.SuppressionFirePassive4" text="{=tor_engineer_suppression_p4}+10 party size." />

  <string id="tor_careerchoice_description.GrenadierKeystone" text="{=tor_engineer_grenadier_key}15-kill grenades refund." />
  <string id="tor_careerchoice_description.GrenadierPassive1" text="{=tor_engineer_grenadier_p1}+3 grenades per pouch." />
  <string id="tor_careerchoice_description.GrenadierPassive2" text="{=tor_engineer_grenadier_p2}+30% grenade radius." />
  <string id="tor_careerchoice_description.GrenadierPassive3" text="{=tor_engineer_grenadier_p3}+30% Fire damage." />
  <string id="tor_careerchoice_description.GrenadierPassive4" text="{=tor_engineer_grenadier_p4}+30% grenade speed." />

  <string id="tor_careerchoice_description.PiercingDoctrineKeystone" text="{=tor_engineer_piercing_key}Bullets overpenetrate." />
  <string id="tor_careerchoice_description.PiercingDoctrinePassive1" text="{=tor_engineer_piercing_p1}+6 ammo per pouch." />
  <string id="tor_careerchoice_description.PiercingDoctrinePassive2" text="{=tor_engineer_piercing_p2}+25% ranged pierce." />
  <string id="tor_careerchoice_description.PiercingDoctrinePassive3" text="{=tor_engineer_piercing_p3}+20% gunpowder damage." />
  <string id="tor_careerchoice_description.PiercingDoctrinePassive4" text="{=tor_engineer_piercing_p4}Ranged troops: +15% damage." />

  <string id="tor_careerchoice_description.RicochetTacticsKeystone" text="{=tor_engineer_ricochet_key}Open Fire!: ricochet; 50% detonate." />
  <string id="tor_careerchoice_description.RicochetTacticsPassive1" text="{=tor_engineer_ricochet_p1}+6 ammo per pouch." />
  <string id="tor_careerchoice_description.RicochetTacticsPassive2" text="{=tor_engineer_ricochet_p2}+15% ranged resist." />
  <string id="tor_careerchoice_description.RicochetTacticsPassive3" text="{=tor_engineer_ricochet_p3}+15% firearm accuracy." />
  <string id="tor_careerchoice_description.RicochetTacticsPassive4" text="{=tor_engineer_ricochet_p4}Always ricochet; 50% detonate; buckshot +3." />

  <string id="tor_careerchoice_description.IncendiaryFusesKeystone" text="{=tor_engineer_fuses_key}Barrage: incendiary upgrades." />
  <string id="tor_careerchoice_description.IncendiaryFusesPassive1" text="{=tor_engineer_fuses_p1}Barrage: +10% damage, ignite, charge." />
  <string id="tor_careerchoice_description.IncendiaryFusesPassive2" text="{=tor_engineer_fuses_p2}Barrage burn: +2s, double stack." />
  <string id="tor_careerchoice_description.IncendiaryFusesPassive3" text="{=tor_engineer_fuses_p3}Barrage cooldown -5s." />
  <string id="tor_careerchoice_description.IncendiaryFusesPassive4" text="{=tor_engineer_fuses_p4}+30% Fire damage." />

  <string id="tor_careerchoice_description.GrandBatteryKeystone" text="{=tor_engineer_battery_key}Barrage: +1 max gun, +1 shell/gun." />
  <string id="tor_careerchoice_description.GrandBatteryPassive1" text="{=tor_engineer_battery_p1}Barrage: +2 shells." />
  <string id="tor_careerchoice_description.GrandBatteryPassive2" text="{=tor_engineer_battery_p2}Barrage: +10% damage." />
  <string id="tor_careerchoice_description.GrandBatteryPassive3" text="{=tor_engineer_battery_p3}Barrage: +impact radius." />
  <string id="tor_careerchoice_description.GrandBatteryPassive4" text="{=tor_engineer_battery_p4}Barrage: +2 shells, cooldown -5s." />

  <string id="tor_engineer_cc_option" text="{=tor_engineer_cc_option}Imperial Engineer" />
  <string id="tor_engineer_cc_effect" text="{=tor_engineer_cc_effect}Engineer Career" />
  <string id="tor_engineer_cc_flavour" text="{=tor_engineer_cc_flavour}You learned the sacred arithmetic of powder, bore and fuse in the Imperial gunnery schools. Now you take the field with rifle, shot and a doctrine simple enough for any soldier to understand: open fire." />

  <string id="tor_engineer_hub_dwarf_contraband_p" text="{=tor_engineer_hub_dwarf_contraband_p}I have heard you can source contraband Dawi firearms. Can we arrange that?" />
  <string id="tor_engineer_dwarf_contraband_upgrade_1" text="{=tor_engineer_dwarf_contraband_upgrade_1}For 500{PRESTIGE_ICON} I can smuggle in apprentice-grade Dawi handguns, crossbows and powder." />
  <string id="tor_engineer_dwarf_contraband_upgrade_2" text="{=tor_engineer_dwarf_contraband_upgrade_2}Another 500{PRESTIGE_ICON} opens a second crate — cannon, grudge-raker, drakefire pistols and the rest of their gunline, but no drakeguns." />
  <string id="tor_engineer_dwarf_contraband_upgrade_3" text="{=tor_engineer_dwarf_contraband_upgrade_3}A final 500{PRESTIGE_ICON} secures their masterwork pieces — trollhammers, drakefire sidearms and the last contraband I dare move through Nuln." />
  <string id="tor_engineer_dwarf_contraband_complete" text="{=tor_engineer_dwarf_contraband_complete}You already bought out every contraband contact I have. Browse my stock when you buy equipment." />
  <string id="tor_engineer_dwarf_contraband_agree" text="{=tor_engineer_dwarf_contraband_agree}Very well. Grease the right palms (Spend 500{PRESTIGE_ICON})." />
  <string id="tor_engineer_dwarf_contraband_decline" text="{=tor_engineer_dwarf_contraband_decline}I cannot afford that right now." />
  <string id="tor_engineer_dwarf_contraband_upgrade_1_done" text="{=tor_engineer_dwarf_contraband_upgrade_1_done}The first crate is on its way. Ask to buy equipment when you are ready — the contraband will be mixed in quietly." />
  <string id="tor_engineer_dwarf_contraband_upgrade_2_done" text="{=tor_engineer_dwarf_contraband_upgrade_2_done}Good. The second shipment should keep your gunline supplied for a long campaign." />
  <string id="tor_engineer_dwarf_contraband_upgrade_3_done" text="{=tor_engineer_dwarf_contraband_upgrade_3_done}That is everything I dare move. Sigmar help us if the Guild ever traces it back to my forge." />
  <string id="tor_engineer_dwarf_contraband_decline_response" text="{=tor_engineer_dwarf_contraband_decline_response}Come back when your purse — and your reputation — can bear it." />
</strings>
